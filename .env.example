# ─── Obrigatorias ────────────────────────────────────────────────────────────

# Webhook do agente de chat (n8n)
VITE_N8N_CHAT_WEBHOOK_URL="https://exemplo.n8n.host/webhook/chat"

# Webhook do diagnostico de site (n8n) — usado como fallback quando o
# PageSpeed nao responde. Deve devolver { score, nivel, nivel_nome, leitura,
# dimensoes: { D1..D4: { nome, pct } } }. Payload fora dessa forma e descartado.
VITE_N8N_DIAGNOSTIC_WEBHOOK_URL="https://exemplo.n8n.host/webhook/diagnostico"

# Agenda da sessao estrategica de 30 minutos (Cal.com).
# Ex.: https://cal.com/raul-vieira/30min
# Vazio = o agente cai no fallback de WhatsApp em vez de abrir a agenda.
VITE_BOOKING_URL="https://cal.com/exemplo/30min"

# ─── Recomendadas ────────────────────────────────────────────────────────────

# Chave da API do Google PageSpeed Insights.
# SEM ELA a API responde 429 (cota diaria por IP esgotada) e o diagnostico cai
# direto no fallback. Gratuita em:
#   https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
VITE_PAGESPEED_API_KEY=""

# Measurement ID do Google Analytics 4 (formato G-XXXXXXXXXX).
# Vazio = nenhum evento e enviado e nenhum script externo e carregado.
# Eventos ja instrumentados: chapter_view, cta_click, agent_intent,
# operational_check, diagnostic_started/completed/failed,
# agent_message_sent/replied/failed, whatsapp_click.
VITE_GA_MEASUREMENT_ID=""
